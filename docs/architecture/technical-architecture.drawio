<mxCell id="title" value="&lt;b&gt;Savonia - Responsible Forest Planning&lt;/b&gt; | Technical architecture" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;fontSize=27;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1570" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Current personal prototype | 26 October 2026 | local QGIS execution and file outputs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;fontSize=16;align=left;fontColor=#526479;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="1570" height="32" as="geometry"/></mxCell>
<mxCell id="qgis" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="115" width="930" height="1040" as="geometry"/></mxCell>
<mxCell id="runtime" value="&lt;b&gt;QGIS DESKTOP | plugin host&lt;/b&gt; | 3.44+ / 4.x | bundled Python / Qt / PyQGIS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="365" y="125" width="880" height="40" as="geometry"/></mxCell>
<mxCell id="input" value="&lt;b&gt;USER INPUT&lt;/b&gt;&lt;br/&gt;AOI polygon / selection&lt;br/&gt;Source choices + output folder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="wizard" value="&lt;b&gt;Wizard / dock&lt;/b&gt;&lt;br/&gt;Gather inputs and capture snapshots&lt;br/&gt;Project + widgets on main thread" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="processing" value="&lt;b&gt;Processing algorithm&lt;/b&gt;&lt;br/&gt;Toolbox / batch / modeler&lt;br/&gt;NoThreading: uses live input layers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="worker" value="&lt;b&gt;ForestAnalysisTask / QgsTask&lt;/b&gt;&lt;br/&gt;Rebuild AOI and source providers&lt;br/&gt;Run with worker-owned layers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="380" y="345" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="services" value="&lt;b&gt;EXTERNAL VECTOR SERVICES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Metsäkeskus WFS (3 products)&lt;br/&gt;Stands / habitats / inventory grid&lt;br/&gt;&lt;br/&gt;SYKE WFS (5 products)&lt;br/&gt;Protected areas (3)&lt;br/&gt;Programmes / groundwater" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#172033;fontFamily=Arial;fontSize=15;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="250" height="250" as="geometry"/></mxCell>
<mxCell id="adapters" value="&lt;b&gt;Source adapters&lt;/b&gt;&lt;br/&gt;Registry + WFS contracts&lt;br/&gt;Provider fields to canonical values&lt;br/&gt;Retrieve, transform, clip, snapshot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="250" height="165" as="geometry"/></mxCell>
<mxCell id="workflow" value="&lt;b&gt;run_workflow(parameters, feedback)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Validate → retrieve → classify + sample grid&lt;br/&gt;→ prepare publication → write outputs&lt;br/&gt;&lt;br/&gt;Explicit inputs / phase results | run ID | cancellation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="690" y="520" width="510" height="165" as="geometry"/></mxCell>
<mxCell id="policy" value="&lt;b&gt;Pure analysis policy&lt;/b&gt;&lt;br/&gt;classification.py / source_readiness.py&lt;br/&gt;domain.py / grid_indicators.py&lt;br/&gt;&lt;br/&gt;Six sensitivity tiers + per-metric coverage&lt;br/&gt;No widgets or QgsProject dependency" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="380" y="770" width="380" height="165" as="geometry"/></mxCell>
<mxCell id="writers" value="&lt;b&gt;Output adapters&lt;/b&gt;&lt;br/&gt;Result-layer / precision adapters&lt;br/&gt;GeoPackage writer + XLSX XML/ZIP writer&lt;br/&gt;&lt;br/&gt;One publication record feeds both files&lt;br/&gt;Partial-file cleanup on caught failures" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="830" y="770" width="370" height="165" as="geometry"/></mxCell>
<mxCell id="outputs" value="&lt;b&gt;LOCAL OUTPUT PAIR&lt;/b&gt;&lt;br/&gt;.gpkg: polygons + source snapshots&lt;br/&gt;.xlsx: tier / class summaries&lt;br/&gt;&lt;br/&gt;Both: coverage, metadata, attribution" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="1330" y="770" width="260" height="165" as="geometry"/></mxCell>
<mxCell id="support" value="&lt;b&gt;Cross-cutting support in the QGIS process&lt;/b&gt;&lt;br/&gt;i18n.py: Finnish / English from QGIS locale | packaged HTML help&lt;br/&gt;app_logging.py: rotating technical.log + separate business-actions.jsonl&lt;br/&gt;Detailed diagnostics to local files; selected summaries to QGIS Log Messages" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="1000" width="820" height="125" as="geometry"/></mxCell>
<mxCell id="consumer" value="&lt;b&gt;Separate value-table model&lt;/b&gt;&lt;br/&gt;Intended downstream use of evidence&lt;br/&gt;No integrated execution in this plugin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="1330" y="1000" width="260" height="135" as="geometry"/></mxCell>
<mxCell id="legend" value="Solid arrows: calls or data flow | dashed arrow: intended manual downstream handoff&lt;br/&gt;Source reads and geometry operations use QGIS providers / spatial APIs; all analysis runs locally." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=16;spacing=14;fontSize=15;align=left;fontColor=#526479;" vertex="1" parent="1"><mxGeometry x="30" y="1190" width="1560" height="65" as="geometry"/></mxCell>
